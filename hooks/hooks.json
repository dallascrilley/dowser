{
  "$schema": "https://json.schemastore.org/claude-code-hooks.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "./prompt-submit/analyze-prompt-skills.ts"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./session-start/load-core-context.ts"
          }
        ]
      }
    ]
  }
}
