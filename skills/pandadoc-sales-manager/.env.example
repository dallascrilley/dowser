# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/sync_db

# QuickBooks OAuth (canonical names)
QUICKBOOKS_CLIENT_ID=your_client_id
QUICKBOOKS_CLIENT_SECRET=your_client_secret
QUICKBOOKS_REDIRECT_URI=http://localhost:8080/callback
QUICKBOOKS_USE_SANDBOX=false
QUICKBOOKS_REALM_ID=your_realm_id

# Copper CRM
COPPER_API_KEY=your_api_key
COPPER_USER_EMAIL=your_email@example.com

# Basecamp OAuth
BASECAMP_ACCESS_TOKEN=your_access_token
BASECAMP_ACCOUNT_ID=your_account_id

# PandaDoc
PANDADOC_API_KEY=your_api_key

# Airtable (optional)
AIRTABLE_API_KEY=your_api_key
AIRTABLE_BASE_ID=your_base_id
AIRTABLE_BASE_ID_QUICKBOOKS=your_qb_base_id
AIRTABLE_BASE_ID_COPPER=your_copper_base_id

# Airtable Source Connector (for reading FROM Airtable)
AIRTABLE_SOURCE_API_KEY=pat.your_personal_access_token
AIRTABLE_SOURCE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_SOURCE_TABLES=Contacts,Companies,Projects

# Application
ENVIRONMENT=production
LOG_LEVEL=INFO

# Pre-sync Validation (Issue #67)
# Validates transformer output matches database schema before syncing
# Helps catch column name mismatches and schema inconsistencies early
SKIP_PRESYNC_VALIDATION=false        # Set to 'true' to disable validation
PRESYNC_VALIDATION_STRICT=false      # Set to 'true' to fail sync on validation errors

# Airtable Deletion Safety
# Prevents catastrophic data loss from API pagination failures or incomplete data fetches
# Sync will fail if deletion thresholds are exceeded
AIRTABLE_MAX_DELETE_PERCENTAGE=50    # Max % of existing records that can be deleted (default: 50%)
AIRTABLE_MAX_DELETE_COUNT=100        # Max absolute number of records that can be deleted (default: 100)
AIRTABLE_MIN_SOURCE_RECORDS=10       # Min source records required to allow deletions (default: 10)

# Codex Autofix (GitHub Actions)
OPENAI_API_KEY=your_openai_api_key
