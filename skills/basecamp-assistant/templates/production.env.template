# Basecamp 4 API - Production Environment Configuration
# Purpose: Production-ready configuration with safety checks and monitoring
# Instructions: Use secure environment variable management for production
# SECURITY: Never commit this file to version control
# SECURITY: Use secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)

# ============================================
# REQUIRED: OAuth 2.0 Authentication
# ============================================

# OAuth 2.0 access token for production account
# Store in secure secrets manager, not in code
# Required: Never expose in logs or error messages
# Rotation: Implement automatic token refresh before expiration (~2 weeks)
ACCESS_TOKEN=

# OAuth 2.0 refresh token for automatic token rotation
# Store securely alongside access_token
# Used to obtain new access_token before expiration
REFRESH_TOKEN=


# ============================================
# REQUIRED: Account ID
# ============================================

# Production Basecamp account ID
# Store as configuration, not secret
# Used to construct all API URLs
ACCOUNT_ID=


# ============================================
# User Agent Configuration
# ============================================

# User-Agent for production requests
# MUST include contact information for abuse reporting
# Format: AppName (support@yourdomain.com)
# Professional example: Acme CRM Integration (support@acme.com)
USER_AGENT="MyApp Production (support@example.com)"


# ============================================
# Environment Identification
# ============================================

# Environment identifier for logging and monitoring
ENVIRONMENT=production

# Application version
APP_VERSION=1.0.0


# ============================================
# Debug & Logging (Disabled in Production)
# ============================================

# Disable debug output in production
# Prevents sensitive data exposure in logs
DEBUG=false

# Disable verbose logging in production
# Reduces log volume and prevents API credential leakage
VERBOSE_LOGGING=false

# Log level: INFO, WARNING, ERROR (never DEBUG in production)
# ERROR: Only log errors and critical issues
LOG_LEVEL=WARNING

# Log format for structured logging (JSON recommended for production)
LOG_FORMAT=json


# ============================================
# Rate Limiting Configuration
# ============================================

# Conservative rate limit for production
# Basecamp hard limit: 50 requests per 10 seconds per IP
# Production maximum: 45 (leaves 10% safety buffer)
# This prevents accidental rate limit violations
MAX_REQUESTS_PER_10S=45

# Request timeout in seconds
# Production timeout should be generous (60s recommended)
# Allows for network latency and processing delays
REQUEST_TIMEOUT=60

# Enable request rate monitoring and alerts
RATE_LIMIT_MONITORING=true

# Alert threshold: warn when approaching rate limit
RATE_LIMIT_WARNING_THRESHOLD=40


# ============================================
# Retry Configuration
# ============================================

# Maximum retry attempts for transient errors (429, 5xx)
# Production should be aggressive with retries
MAX_RETRIES=5

# Initial backoff time in seconds (exponential backoff: 1s, 2s, 4s, 8s, 16s)
INITIAL_BACKOFF_SECONDS=1

# Maximum backoff time to prevent excessive waits
MAX_BACKOFF_SECONDS=30


# ============================================
# Error Handling
# ============================================

# Fail immediately on 404 errors (don't retry)
# 404 indicates permanent condition (deleted resource or no access)
FAIL_ON_404=true

# Don't fail on rate limits (429) - implement retry logic
# Rate limits are temporary and should be retried with backoff
FAIL_ON_RATE_LIMIT=false

# Continue on transient server errors (5xx) with exponential backoff
CONTINUE_ON_5XX=true


# ============================================
# Monitoring & Alerting
# ============================================

# Enable error tracking and reporting
ERROR_TRACKING_ENABLED=true

# Sentry DSN for error reporting (optional)
# Leave blank to disable error tracking
# Get from https://sentry.io after creating project
SENTRY_DSN=

# DataDog API key for metrics (optional)
# Leave blank to disable DataDog integration
DATADOG_API_KEY=

# Enable performance monitoring
PERFORMANCE_MONITORING=true

# Enable health check reporting
HEALTH_CHECK_ENABLED=true


# ============================================
# Webhook Configuration (if using webhooks)
# ============================================

# Basecamp webhook endpoint URL
# MUST use HTTPS protocol
# Endpoint must return 2xx status code to avoid deactivation
WEBHOOK_URL=https://your-app.com/webhooks/basecamp

# Webhook secret for HMAC validation (optional)
# If set, validate webhook signatures for security
WEBHOOK_SECRET=

# Enable webhook signature validation
WEBHOOK_VALIDATION=true

# Maximum webhook delivery attempts before deactivation
WEBHOOK_MAX_ATTEMPTS=10


# ============================================
# Data Retention & Caching
# ============================================

# Enable HTTP caching with ETags to reduce API calls
# Reduces rate limit usage, improves performance
HTTP_CACHING=true

# Cache duration in seconds
# How long to keep ETag-based cache
CACHE_DURATION=3600

# Enable request batching where supported
# Groups related requests together
REQUEST_BATCHING=true


# ============================================
# Backup & Redundancy
# ============================================

# Backup account ID for failover (optional)
# If primary account becomes unavailable, use this
BACKUP_ACCOUNT_ID=

# Enable automatic failover to backup account
AUTO_FAILOVER=false


# ============================================
# Security & Compliance
# ============================================

# Enable HTTPS certificate verification
VERIFY_SSL=true

# Minimum TLS version (1.2 recommended)
MIN_TLS_VERSION=1.2

# Enable request/response logging for audit trail
AUDIT_LOGGING=true

# Redact sensitive fields in logs
REDACT_SENSITIVE_DATA=true

# Fields to redact in logs (comma-separated)
SENSITIVE_FIELDS=ACCESS_TOKEN,REFRESH_TOKEN,WEBHOOK_SECRET


# ============================================
# Operational Settings
# ============================================

# Circuit breaker: fail fast if API unavailable
CIRCUIT_BREAKER_ENABLED=true

# Circuit breaker threshold: fail after N consecutive errors
CIRCUIT_BREAKER_THRESHOLD=10

# Circuit breaker recovery timeout in seconds
CIRCUIT_BREAKER_TIMEOUT=300

# Enable graceful degradation
GRACEFUL_DEGRADATION=true

# Enable rate limit backoff strategy
BACKOFF_STRATEGY=exponential

# Connection pool size for concurrent requests
POOL_SIZE=10

# Maximum queue size for pending requests
MAX_QUEUE_SIZE=1000
