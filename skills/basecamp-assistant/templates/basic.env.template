# Basecamp 4 API - Basic Configuration Template
# Purpose: Minimal setup for simple integrations
# Instructions: Copy this file to .env and fill in your values
# Never commit .env files to version control

# ============================================
# REQUIRED: OAuth 2.0 Authentication
# ============================================

# Your OAuth 2.0 access token obtained from Basecamp
# How to get it:
#   1. Go to https://launchpad.37signals.com/integrations
#   2. Create a new OAuth application
#   3. Complete the authorization flow
#   4. Copy the access_token value (NOT the entire JSON response)
# Example: BAhbByIBsH4Gw--7ba4c0252a3aa3b1de2c15c5be2c4ef8c8f8
ACCESS_TOKEN=your_token_here


# ============================================
# REQUIRED: Account ID
# ============================================

# Your Basecamp account ID
# How to find it:
#   - It appears in your Basecamp URL: https://3.basecamp.com/{ACCOUNT_ID}/
#   - Or use GET https://launchpad.37signals.com/authorization.json
# Example: 195539477
ACCOUNT_ID=


# ============================================
# REQUIRED: User-Agent Header
# ============================================

# Identifies your application to Basecamp API
# Format: AppName (contact@example.com)
# Components:
#   - AppName: Your application name
#   - contact@example.com: Your contact email or website
#
# This header is MANDATORY on every request
# Missing it results in "400 Bad Request" with no retry possible
# Examples:
#   User-Agent=Acme CRM Integration (api@acme.com)
#   User-Agent=Marketing Dashboard (support@startup.io)
#   User-Agent=Fabian's Integration (fabian@example.com)
USER_AGENT="MyApp (me@example.com)"
