# Basecamp 4 API - Development Environment Configuration
# Purpose: Configuration for development and testing
# Instructions: Copy this file to .env.development and fill in your test values
# Use a separate Basecamp account or test projects for development

# ============================================
# REQUIRED: OAuth 2.0 Authentication
# ============================================

# OAuth 2.0 access token for development account
# Use a separate development account to avoid polluting production data
# See basic.env.template for instructions on obtaining tokens
ACCESS_TOKEN=your_dev_token_here


# ============================================
# REQUIRED: Account ID
# ============================================

# Account ID for your development Basecamp account
# Use a separate account from production if possible
ACCOUNT_ID=


# ============================================
# User Agent Configuration
# ============================================

# User-Agent for development requests
# Include "Dev" to distinguish from production in logs
USER_AGENT="MyApp Dev (dev@example.com)"


# ============================================
# Development Project IDs
# ============================================

# Create test projects in your development account and add IDs here
# These are used for running integration tests and manual testing

# Default project ID for ad-hoc testing
# Get this from creating a test project: https://3.basecamp.com/{ACCOUNT_ID}/projects/{PROJECT_ID}
DEV_PROJECT_ID=

# Project ID for automated integration tests
# Create a dedicated test project for CI/CD pipeline tests
TEST_PROJECT_ID=


# ============================================
# Debug & Logging
# ============================================

# Enable debug output for troubleshooting
# Shows verbose request/response details, API calls made, timing info
DEBUG=true

# Enable verbose logging of all HTTP requests and responses
# Logs request headers, body, response status, timing
VERBOSE_LOGGING=true

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG


# ============================================
# Rate Limiting Configuration
# ============================================

# Conservative rate limit for development
# Basecamp limit is 50 requests per 10 seconds
# Development should use less to avoid accidental rate limit hits
# 30 requests per 10 seconds = 3 per second (safe margin)
MAX_REQUESTS_PER_10S=30

# Request timeout in seconds
# Development timeout can be longer for debugging
REQUEST_TIMEOUT=30


# ============================================
# Retry Configuration
# ============================================

# Maximum number of retries for 429 and 5xx errors
MAX_RETRIES=3

# Initial backoff time in seconds for exponential backoff
# Starts at this value, doubles with each retry
INITIAL_BACKOFF_SECONDS=2


# ============================================
# Testing Configuration
# ============================================

# Enable test mode - skips some validations
# Useful for testing error handling paths
TEST_MODE=false

# Collect test coverage metrics
COVERAGE_ENABLED=true

# Store API responses for debugging and test fixtures
RECORD_API_RESPONSES=true
