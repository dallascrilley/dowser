# ============================================================================
# Acuity Scheduling API - Credentials Configuration Template
# ============================================================================
#
# This file contains all environment variables needed for Acuity API integration.
# Store actual values in .env file (never commit to version control).
#
# Setup Steps:
# 1. Copy this file to .env
# 2. Obtain credentials from Acuity dashboard: Settings → Integrations → API
# 3. Fill in your User ID and API Key
# 4. Adjust settings for your environment
#
# Last Updated: 2025-11-11
# ============================================================================

# ============================================================================
# REQUIRED: API CREDENTIALS
# ============================================================================
# Obtain these from: Acuity Scheduling → Settings → Integrations → API
# User ID: Numeric identifier (e.g., 12345678)
# API Key: Alphanumeric string (e.g., abc123def456xyz789)
#
# SECURITY: Treat API Key like a password!
# - Never hardcode in source files
# - Never commit to version control
# - Rotate keys every 90 days
# - Use separate keys for dev/staging/prod
#
ACUITY_USER_ID=
ACUITY_API_KEY=

# ============================================================================
# BASE CONFIGURATION
# ============================================================================
# API endpoint - standard for all Acuity accounts
ACUITY_BASE_URL=https://acuityscheduling.com/api/v1

# Environment identifier (development, staging, production)
# Affects logging verbosity, caching behavior, and monitoring
ENVIRONMENT=development

# Webhook configuration (optional if using webhooks)
# Full HTTPS URL where Acuity sends appointment events
# Format: https://yourdomain.com/webhooks/acuity
ACUITY_WEBHOOK_URL=

# Webhook secret for signature verification
# Use your admin API key or oauth token for signature validation
ACUITY_WEBHOOK_SECRET=

# ============================================================================
# CACHING CONFIGURATION
# ============================================================================
# Cache frequently-accessed data to reduce API calls and improve performance

# Enable/disable caching (true/false)
CACHE_ENABLED=true

# Appointment types cache TTL (time-to-live in seconds)
# These rarely change, safe to cache 24 hours
CACHE_TTL_APPOINTMENT_TYPES=86400

# Availability cache TTL in seconds
# Development: longer caches (5 minutes)
# Production: shorter caches (2-3 minutes)
# Shorter TTL = more accurate availability but more API calls
CACHE_TTL_AVAILABILITY=300

# Calendars cache TTL (staff/resource configuration)
# Update frequency: low (staff changes infrequently)
CACHE_TTL_CALENDARS=21600  # 6 hours

# Forms/fields cache TTL (intake form configuration)
# Update frequency: low
CACHE_TTL_FORMS=43200  # 12 hours

# ============================================================================
# REDIS CACHE BACKEND (Optional - for production multi-instance setups)
# ============================================================================
# If not configured, falls back to in-memory cache (suitable for single instance)
# Redis required for distributed systems (multiple servers sharing cache)

# Redis host/port
REDIS_HOST=localhost
REDIS_PORT=6379

# Redis database number (0-15, usually 0 for app cache)
REDIS_DB=0

# Redis password (if authentication required)
REDIS_PASSWORD=

# Redis connection pool size (for high-concurrency scenarios)
REDIS_POOL_SIZE=10

# ============================================================================
# RATE LIMITING CONFIGURATION
# ============================================================================
# Acuity API limits: 10 requests/second, 20 concurrent connections
# Configure backoff strategy for respecting rate limits

# Target requests per second (should be < 10 to stay safely under limit)
RATE_LIMIT_PER_SECOND=9

# Exponential backoff base for retries (2^n formula: 1s, 2s, 4s, 8s, 16s, ...)
RATE_LIMIT_BACKOFF_BASE=2

# Maximum retries for rate-limited requests (429 errors)
RATE_LIMIT_MAX_RETRIES=5

# Connection concurrency limit (should stay < 20)
RATE_LIMIT_MAX_CONCURRENT=15

# ============================================================================
# WEBHOOK CONFIGURATION
# ============================================================================

# Enable webhook signature verification
# Production: true (REQUIRED for security)
# Development: false (optional, for testing)
WEBHOOK_SIGNATURE_VALIDATION=false

# Webhook event subscriptions to listen for
# Comma-separated list of events
# Options: scheduled, rescheduled, canceled, changed, all
WEBHOOK_EVENTS=scheduled,rescheduled,canceled,changed

# Webhook queue backend
# Options: memory (single instance), redis (distributed), rabbitmq (advanced)
WEBHOOK_QUEUE_BACKEND=memory

# Webhook queue timeout (seconds before marking as failed)
WEBHOOK_QUEUE_TIMEOUT=30

# Webhook duplicate prevention TTL (seconds)
# Prevents processing same webhook twice if delivered multiple times
WEBHOOK_DUPLICATE_TTL=3600

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level for Acuity API operations
# Options: DEBUG (verbose), INFO (normal), WARNING (errors only), ERROR (critical only)
LOG_LEVEL=INFO

# Log file location
# Relative paths are relative to application root
LOG_FILE=logs/acuity_api.log

# Log rotation
# Size-based: rotate when file reaches N MB
LOG_MAX_SIZE_MB=10

# Backup log files to keep
LOG_BACKUP_COUNT=5

# Detailed API logging (logs request/response bodies)
# Caution: may log sensitive data
LOG_DETAILED_API=false

# ============================================================================
# TIMEZONE CONFIGURATION
# ============================================================================

# Business timezone (where your appointments are scheduled)
# Format: IANA timezone name (e.g., America/New_York, Europe/London)
# Used as default when client timezone not specified
BUSINESS_TIMEZONE=America/New_York

# Default client timezone (for availability checks)
# Can be overridden per request
DEFAULT_CLIENT_TIMEZONE=America/New_York

# ============================================================================
# MONITORING & ALERTING CONFIGURATION
# ============================================================================

# Enable health monitoring
# Checks API connectivity, webhook status, rate limits
ENABLE_MONITORING=false

# Alert on authentication failures
ALERT_ON_AUTH_FAILURE=true

# Alert on rate limit approaching (when remaining < 2 requests)
ALERT_ON_RATE_LIMIT=true

# Alert on webhook delivery failures
ALERT_ON_WEBHOOK_FAILURE=true

# Monitoring check interval (seconds)
# How often to check API health
MONITORING_INTERVAL=300

# Alert destination (email, slack, pagerduty, etc.)
# Format: service://config
# Example: slack://webhook_url or email://recipient@domain.com
ALERT_DESTINATION=

# ============================================================================
# INTEGRATION ENDPOINTS (Optional)
# ============================================================================

# CRM Integration
# Format: crm_type://api_endpoint with auth params
# Examples:
# - salesforce://instance.salesforce.com
# - hubspot://api.hubapi.com (with HUBSPOT_API_KEY env var)
# - copper://api.copper.com (with COPPER_API_KEY env var)
CRM_API_ENDPOINT=

# Email Service Integration
# For sending confirmations outside of Acuity's built-in emails
# Examples:
# - sendgrid://api.sendgrid.com (with SENDGRID_API_KEY)
# - mailgun://api.mailgun.net (with MAILGUN_API_KEY)
EMAIL_SERVICE_ENDPOINT=

# Calendar Sync (Google Calendar, Outlook, etc.)
# For syncing appointments to external calendars
CALENDAR_SYNC_ENDPOINT=

# ============================================================================
# ENVIRONMENT-SPECIFIC OVERRIDES
# ============================================================================
# Load environment-specific files with: source .env .env.$ENVIRONMENT

# Development-specific settings (auto-loaded if ENVIRONMENT=development)
# Create .env.development with overrides:
# - Longer cache TTLs (testing data freshness less critical)
# - Verbose logging
# - Webhook signature validation disabled
# - Increased rate limit for development convenience

# Staging-specific settings
# - Match production closely
# - Enable monitoring but with increased alert thresholds
# - Moderate logging

# Production-specific settings
# - Optimal cache TTLs
# - Minimal logging (avoid performance impact)
# - Strict error handling
# - All monitoring and alerts enabled
# - Production-grade error handling

# ============================================================================
# ADVANCED CONFIGURATION (Usually not needed)
# ============================================================================

# HTTP timeout (seconds) for API requests
HTTP_TIMEOUT=30

# Retry failed requests on 500/503 errors
ENABLE_SERVER_ERROR_RETRY=true

# Custom headers to include in all API requests
# Format: HEADER_NAME=value (multiple: comma-separated)
CUSTOM_HEADERS=

# Proxy configuration (if behind corporate proxy)
# Format: PROTOCOL://user:password@host:port
HTTP_PROXY=
HTTPS_PROXY=

# ============================================================================
# CREDENTIAL VALIDATION
# ============================================================================
# After setting up this file, validate credentials by running:
#   python -m acuity_schedule_manager.validate_credentials
#
# Expected output:
#   ✅ API credentials valid
#   ✅ User ID: your_user_id
#   ✅ API Key: ****last4digits
#   ✅ Connection successful
#
# Troubleshooting:
#   ❌ 401 Unauthorized: Check User ID and API Key
#   ❌ 403 Forbidden: Insufficient permissions (need admin role)
#   ❌ Network error: Check firewall/proxy settings
#
# ============================================================================
