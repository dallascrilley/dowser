# Copper CRM API Configuration
# API key for authenticating with Copper CRM API
# Get this from your Copper CRM account settings > Integrations > API
COPPER_API_KEY=your_api_key_here

# Email address associated with your Copper CRM account
# Used for API request identification and logging
COPPER_USER_EMAIL=your_email@example.com

# Base URL for Copper CRM API endpoints
# Standard endpoint for Copper's developer API v1
COPPER_BASE_URL=https://api.copper.com/developer_api/v1

# Optional: Rate Limiting Configuration
# Number of standard (non-bulk) API requests allowed per second
# Copper standard rate limit is typically 180 requests per minute
COPPER_RATE_LIMIT_STANDARD=180

# Number of bulk API requests allowed per second
# Copper bulk operations have a lower rate limit (typically 3 per minute)
COPPER_RATE_LIMIT_BULK=3

# Optional: Retry Configuration
# Maximum number of retry attempts for failed API requests
# Useful for handling transient network errors
COPPER_MAX_RETRIES=5

# Delay in seconds between retry attempts (exponential backoff applied)
# Initial delay before retrying a failed request
COPPER_RETRY_DELAY=1
