{
  "name": "dowser",
  "version": "1.0.0",
  "description": "Claude Code plugin that surfaces the right skill from a curated skill library",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Dallas Crilley",
    "email": "dallas@dallascrilley.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dallascrilley/dowser.git"
  },
  "bugs": {
    "url": "https://github.com/dallascrilley/dowser/issues"
  },
  "homepage": "https://github.com/dallascrilley/dowser#readme",
  "keywords": [
    "claude-code",
    "skills",
    "plugin",
    "skill-discovery",
    "fuzzy-matching",
    "tfidf",
    "hybrid-search"
  ],
  "scripts": {
    "test": "bun test hooks/__tests__",
    "test:garden": "bash ./scripts/check-frontmatter.sh skills",
    "check:skills": "bash ./scripts/garden.sh skills",
    "evals": "bun run evals/run-evals.ts",
    "test:all": "bun test"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "fuse.js": "^7.1.0",
    "glob": "^10.0.0",
    "gray-matter": "^4.0.3",
    "natural": "^8.1.0",
    "sylvester": "^0.0.21"
  },
  "devDependencies": {
    "@types/bun": "^1.0.0"
  },
  "packageManager": "pnpm@11.24.0"
}
